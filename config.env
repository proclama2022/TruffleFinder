# Environment variables for the server

# Database connection string
DATABASE_URL="your_database_url_here"

# Drizzle Studio connection string (optional)
DRIZZLE_STUDIO_URL="your_drizzle_studio_url_here"

# Flag to show coming soon page (true/false)
SHOW_COMING_SOON=false

# Make.com Webhook Configuration
MAKE_WEBHOOK_URL="https://hook.eu1.make.com/c5m0in4ahhbmo9yejec3bf89ssl2iszk"

# Nodemailer Email Configuration (deprecated - now using Make.com webhook)
EMAIL_HOST="your_smtp_host"
EMAIL_PORT="your_smtp_port" # e.g., 587 for TLS, 465 for SSL
EMAIL_SECURE="false" # true for 465, false for other ports like 587
EMAIL_USER="your_email_username"
EMAIL_PASS="your_email_password"
EMAIL_FROM="your_email_address" # This will be the 'from' address in the emails
NOTIFICATION_EMAIL="recipient_email_address" # The email address where notifications will be sent